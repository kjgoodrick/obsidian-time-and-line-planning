{
  "name": "timeline-gantt-view",
  "version": "1.0.0-thanksgiving.11",
  "description": "A Set of Gantt Chart / Timeline Views for Obsidian Bases.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && npm test && npm run build && python3 scripts/package.py",
    "test:webkit": "node tests/webkit/serve.mjs",
    "test:webkit:simulator": "node tests/webkit/launch.mjs"
  },
  "keywords": [],
  "author": "Sabidurian",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "happy-dom": "21.0.4",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
